{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The top level is local development only (`wrangler dev` and the tests). It is
  // named apart from both deployed Workers so a deploy without --env can never
  // replace one of them. Deploy with utils/deploy/stage.sh or prod.sh.
  "name": "bugzap-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",

  // The widget bundle (dist/assets/v1/bugzap.js) is served as a static asset.
  // Anything that is not a file falls through to the Worker.
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
  },

  // Rebuilds the widget before every `wrangler dev` reload, and on save under src/widget.
  "build": {
    "command": "node utils/build-widget.js",
    "watch_dir": "src/widget",
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bugzap",
      // Never a real database: local dev ignores the id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],

  "r2_buckets": [
    {
      "binding": "SHOTS",
      "bucket_name": "bugzap-shots",
    },
  ],

  // SIGNUP_ALLOWLIST: addresses and @domains that may sign in to the dashboard,
  // comma-separated. Empty admits nobody.
  "secrets": { "required": ["SITE_KEK", "SIGNUP_ALLOWLIST"] },

  "ratelimits": [
    {
      "name": "INGEST_BURST",
      "namespace_id": "2833001",
      "simple": { "limit": 5, "period": 10 },
    },
    {
      "name": "PINS_READ",
      "namespace_id": "2833002",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      // Sign-in link requests, counted per IP address and per email address.
      "name": "LOGIN_BURST",
      "namespace_id": "2833003",
      "simple": { "limit": 5, "period": 60 },
    },
  ],

  // Hourly cleanup: expired sign-in links and sessions, and unclaimed screenshots.
  "triggers": { "crons": ["17 * * * *"] },

  "vars": {
    // console prints mail to the terminal; cloudflare sends it (needs a sending domain).
    "MAIL_MODE": "console",
  },

  "observability": {
    "enabled": true,
  },

  // Bindings and vars are not inherited by an environment, so each one repeats
  // them with its own database, bucket, and rate-limit namespaces. Assets, the
  // build command, the cron trigger, and observability are inherited.
  "env": {
    "staging": {
      "name": "bugzap-staging",
      "account_id": "30aa05fc7822ef63635046e5c7771a9a",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bugzap-staging",
          // Replace with the id `wrangler d1 create bugzap-staging` prints.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "SHOTS", "bucket_name": "bugzap-shots-staging" }],
      "secrets": { "required": ["SITE_KEK", "SIGNUP_ALLOWLIST"] },
      "ratelimits": [
        { "name": "INGEST_BURST", "namespace_id": "283311", "simple": { "limit": 5, "period": 10 } },
        { "name": "PINS_READ", "namespace_id": "283312", "simple": { "limit": 60, "period": 60 } },
        { "name": "LOGIN_BURST", "namespace_id": "283313", "simple": { "limit": 5, "period": 60 } },
      ],
      "vars": { "MAIL_MODE": "console" },
    },
    "production": {
      "name": "bugzap",
      "account_id": "30aa05fc7822ef63635046e5c7771a9a",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bugzap-production",
          // Replace with the id `wrangler d1 create bugzap-production` prints.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "SHOTS", "bucket_name": "bugzap-shots-production" }],
      "secrets": { "required": ["SITE_KEK", "SIGNUP_ALLOWLIST"] },
      "ratelimits": [
        { "name": "INGEST_BURST", "namespace_id": "283321", "simple": { "limit": 5, "period": 10 } },
        { "name": "PINS_READ", "namespace_id": "283322", "simple": { "limit": 60, "period": 60 } },
        { "name": "LOGIN_BURST", "namespace_id": "283323", "simple": { "limit": 5, "period": 60 } },
      ],
      "vars": { "MAIL_MODE": "console" },
    },
  },
}
