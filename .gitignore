*.backup
*.old
*.orig
*.rej
*.sh~
*.bash_history
~$*
.~lock.*#

#/ --- Archives (release assets) -------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ============================================================
# END Ziad's boilerplate .gitignore
# ============================================================
# --- Bugzap -------------------------------------------------
# Re-include what the boilerplate drops but this repo needs.
!migrations/*.sql
!package-lock.json
# Wrangler's local state (D1, R2) and local secrets
.wrangler/
.dev.vars
.dev.vars.*
# Editor config stays local
.vscode/
